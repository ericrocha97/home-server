# Only for static Compose syntax validation; Ansible writes the fingerprinted digest-pinned reference at deploy time.
N8N_IMAGE=local/n8n:lint
N8N_PORT_HOST=15678
N8N_UID=1000
N8N_GID=1000
BASE_DOMAIN=lab.arpa
N8N_EDITOR_BASE_URL=https://n8n.lab.arpa
WEBHOOK_URL=https://n8n.lab.arpa/
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=changeme-n8n
N8N_ENCRYPTION_KEY=changeme-hex-64-chars-never-regenerate
TZ=Etc/UTC
# Shared automation DB (Ansible-generated .env contains real Vault values and is ignored)
AUTOMATION_DB_HOST=postgres
AUTOMATION_DB_PORT=5432
AUTOMATION_DB_NAME=automation
AUTOMATION_DB_USER=automation_writer
AUTOMATION_DB_PASSWORD=changeme-automation-writer
# Service discovery metadata (Ansible deriva a URL de base_domain)
LABMONITOR_ENABLED=true
LABMONITOR_ID=n8n
LABMONITOR_NAME=n8n
LABMONITOR_CATEGORY=automation
LABMONITOR_ICON=n8n
LABMONITOR_OPEN_URL=https://n8n.lab.arpa
