# Only for static Compose syntax validation; Ansible writes the fingerprinted local image at deploy time.
JENKINS_IMAGE=local/jenkins-bluefin:lint
JENKINS_PORT=18080
JENKINS_UID=1000
JENKINS_GID=1000
JENKINS_URL=https://jenkins.lab.arpa
# Jenkins admin inicial (Vault em prod)
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=changeme
# Jenkins read-only providers (Vault em prod — valores reais nunca entram no Git)
JENKINS_LABMONITOR_USER=labmonitor-api
JENKINS_LABMONITOR_PASSWORD=changeme-labmonitor
JENKINS_LABMONITOR_API_TOKEN=changeme-labmonitor-token
JENKINS_PROMETHEUS_USER=prometheus-scraper
JENKINS_PROMETHEUS_PASSWORD=changeme-prometheus
JENKINS_PROMETHEUS_API_TOKEN=changeme-prometheus-token
# Service discovery metadata (Ansible deriva a URL de base_domain)
LABMONITOR_ENABLED=true
LABMONITOR_ID=jenkins
LABMONITOR_NAME=Jenkins
LABMONITOR_CATEGORY=automation
LABMONITOR_ICON=jenkins
LABMONITOR_OPEN_URL=https://jenkins.lab.arpa
