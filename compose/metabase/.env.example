# Ansible writes the full name:tag@sha256:<64-hex> reference here.
METABASE_IMAGE=
METABASE_PORT=13001
METABASE_UID=2000
METABASE_GID=2000
METABASE_DB_NAME=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=changeme-metabase
TZ=Etc/UTC
# Shared automation DB (Ansible-generated .env contains real Vault values and is ignored)
AUTOMATION_DB_HOST=postgres
AUTOMATION_DB_PORT=5432
AUTOMATION_DB_NAME=automation
AUTOMATION_DB_USER=automation_reader
AUTOMATION_DB_PASSWORD=changeme-automation-reader
