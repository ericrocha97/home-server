# Only for static Compose syntax validation; Ansible writes the fingerprinted digest-pinned reference at deploy time.
POSTGRES_IMAGE=local/postgres:lint
POSTGRES_SUPERUSER_USER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme-superuser-32chars
POSTGRES_SUPERUSER_DB=postgres
POSTGRES_PORT=15432
# DBs de aplicação (senhas via Vault, não commitar)
POSTGRES_N8N_DB=n8n
POSTGRES_N8N_USER=n8n
POSTGRES_N8N_PASSWORD=changeme-n8n
POSTGRES_METABASE_DB=metabase
POSTGRES_METABASE_USER=metabase
POSTGRES_METABASE_PASSWORD=changeme-metabase
POSTGRES_AUTOMATION_DB=automation
POSTGRES_AUTOMATION_WRITER=automation_writer
POSTGRES_AUTOMATION_READER=automation_reader
