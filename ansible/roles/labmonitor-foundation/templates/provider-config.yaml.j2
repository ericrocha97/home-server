---
# LabMonitor provider endpoints — non-sensitive values only.
# Rendered into the labmonitor-provider-config ConfigMap data by the
# labmonitor-foundation role. Endpoints follow the deployed service ports.
schema: labmonitor.providers/v1
providers:
  prometheus:
    base_url: http://prometheus.monitoring.svc.cluster.local:{{ monitoring_prometheus_service_port }}
  docker:
    base_url: http://{{ server_lan_ip }}:12375
  jenkins:
    base_url: http://{{ server_lan_ip }}:{{ compose_jenkins_port }}
  kubernetes:
    mode: in_cluster
