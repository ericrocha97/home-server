---
# LabMonitor Jenkins read-only credential (Task 7) — Vault values only.
# Rendered by the labmonitor-foundation role with no_log and applied as the
# labmonitor-jenkins-readonly Secret. Carries exactly the Task 3 read-only
# provider username + api-token and nothing else.
apiVersion: v1
kind: Secret
metadata:
  name: "{{ labmonitor_jenkins_secret_name }}"
  namespace: "{{ labmonitor_namespace }}"
type: Opaque
stringData:
  username: "{{ jenkins_labmonitor_user }}"
  api-token: "{{ jenkins_labmonitor_api_token }}"
